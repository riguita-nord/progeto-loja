#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"

if ! command -v java >/dev/null 2>&1; then
    printf '%s\n' 'Java is required to run the Maven Wrapper.' >&2
    exit 1
fi

if [ ! -f "$WRAPPER_JAR" ]; then
    printf '%s\n' 'Maven Wrapper JAR is missing from backend/.mvn/wrapper.' >&2
    exit 1
fi

exec java -classpath "$WRAPPER_JAR" \
    -Dmaven.multiModuleProjectDirectory="$SCRIPT_DIR" \
    org.apache.maven.wrapper.MavenWrapperMain "$@"
